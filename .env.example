# OAuth client credentials for the three providers. Copy this file to .env and fill in the
# ANTIGRAVITY_* values (the only ones that are an actual secret shape GitHub's push protection
# flags), then run `scripts/generate_credentials.sh` (or just `./scripts/build_app.sh`, which
# calls it automatically) to turn .env into Sources/ClaudeQuota/Auth/GeneratedCredentials.swift.
#
# Full provenance and manual re-derivation instructions for every value below:
# doc/features/oauth-credentials.md

# Claude (Anthropic) OAuth client id. Not a secret-shaped value (GitHub doesn't flag it), so the
# real value is filled in directly here for convenience.
CLAUDE_CLIENT_ID=xxxxxxx

# Codex (OpenAI) OAuth client id. Also not secret-shaped.
CODEX_CLIENT_ID=xxxxxxx

# Antigravity (Google) OAuth client id/secret. The secret matches Google's registered
# "GOCSPX-" pattern, which GitHub push protection actively scans for — do not put the real
# value here. Run `scripts/fetch_secrets.sh` to pull the current value automatically, or see
# doc/features/oauth-credentials.md for the manual source.
ANTIGRAVITY_CLIENT_ID=REPLACE_ME
ANTIGRAVITY_CLIENT_SECRET=REPLACE_ME
