# OAuth client credentials for the three providers. Copy this file to .env and fill in every
# REPLACE_ME below, then run `scripts/generate_credentials.sh` (or just `./scripts/build_app.sh`,
# which calls it automatically) to turn .env into Sources/ClaudeQuota/Auth/GeneratedCredentials.swift.
#
# None of these are committed anywhere, ever, on purpose — full provenance and manual
# re-derivation instructions for every value below: doc/features/oauth-credentials.md
#
# Run `scripts/fetch_secrets.sh` first — it fills in Antigravity and Codex automatically by
# pulling from their public sources. Claude has to be filled in by hand (see the doc above).

# Claude (Anthropic) OAuth client id.
CLAUDE_CLIENT_ID=REPLACE_ME

# Codex (OpenAI) OAuth client id.
CODEX_CLIENT_ID=REPLACE_ME

# Antigravity (Google) OAuth client id/secret.
ANTIGRAVITY_CLIENT_ID=REPLACE_ME
ANTIGRAVITY_CLIENT_SECRET=REPLACE_ME
